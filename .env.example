DATABASE_URL=sqlite:///./provisioner.db
# approval matches the problem statement; strict adds department restrictions.
ACCESS_POLICY_MODE=approval
# Optional: enables AI review using read-only LangChain tools.
# Groq is preferred when both provider keys are set.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional alternative provider:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
