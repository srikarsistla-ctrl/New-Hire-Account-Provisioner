{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-hire-account-provisioner",
  "main": "worker-src/cloudflare/worker.py",
  "base_dir": "worker-src",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["python_workers"],
  "build": { "command": "node scripts/build-cloudflare.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "ACCESS_POLICY_MODE": "approval",
    "GROQ_MODEL": "llama-3.3-70b-versatile"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "new-hire-provisioner",
    "database_id": "886ae215-caae-42f7-ad5d-750bbfc1e0fd",
    "migrations_dir": "migrations"
  }]
}
